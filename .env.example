# Copy to .env and fill in real values. Never commit .env.
#
# ==========================================================================
# THREE ENVIRONMENT SHAPES — everything below is one flat list of vars, but
# in practice you'll run this app in one of three shapes. This header is a
# quick reference; each variable's own comment has the full explanation.
#
# 1. DEVELOPMENT (local machine, `npm run dev`)
#    - AMAZON_PROVIDER=mock, CONTENT_GENERATION=mock, PUBLIC_CATALOG_ENABLED=true
#    - DATABASE_URL points at the local docker-compose Postgres (port 5433)
#    - ADMIN_PASSWORD_HASH may be left empty — /admin is open locally
#      when unset, but only outside production (see lib/admin/auth.ts)
#
# 2. STAGING / PRE-LAUNCH (real VPS, real domain, no real Amazon data yet)
#    - AMAZON_PROVIDER=mock (still — Creators API isn't ready), AUTO_PUBLISH=false
#    - PUBLIC_CATALOG_ENABLED=false — the homepage/institutional pages are
#      live, but /produto, /categorias, /ofertas, /melhores, /comparar stay
#      hidden/noindex so no fictional price is ever shown publicly. See
#      lib/config/public-catalog.ts and docs/PRODUCTION_READINESS.md
#      (SITE_LAUNCH_READY vs CATALOG_LAUNCH_READY).
#    - NEXT_PUBLIC_SITE_URL=https://precocaindo.com.br
#    - ADMIN_PASSWORD_HASH is REQUIRED — generate with
#      `npm run admin:hash-password -- 'your-password'`
#
# 3. PRODUCTION LIVE (real Amazon Creators API traffic — future, not this sprint)
#    - AMAZON_PROVIDER=live only after `npm run amazon:compliance` passes AND
#      a human has confirmed BR account approval + qualified sales with Amazon
#    - PUBLIC_CATALOG_ENABLED=true only once real (non-mock) data exists
#
# isPublicCatalogSafeToShow() (lib/config/public-catalog.ts) enforces the
# one rule that can never be overridden by any of these flags: production +
# AMAZON_PROVIDER=mock + PUBLIC_CATALOG_ENABLED=true is always rejected,
# regardless of what's set here.
# ==========================================================================

# --- Database ---
# DEV: local docker-compose Postgres, port 5433 (see README.md).
# STAGING/PRODUCTION: the `db` service name from docker-compose.prod.yml
# (e.g. postgresql://precocaindo:REAL_PASSWORD@db:5432/precocaindo) — never
# reuse the dev credentials above in a real deploy.
DATABASE_URL="postgresql://precocaindo:precocaindo@localhost:5433/precocaindo"

# --- Site ---
# DEV: http://localhost:3000. STAGING/PRODUCTION: https://precocaindo.com.br
# — production:readiness's DOMAIN_CONFIGURED check requires the exact
# production value.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PreçoCaindo"

# --- Amazon provider (global) ---
# mock: uses MockAmazonProvider, no external calls, safe for local dev.
# live: uses AmazonProvider (Creators API). Requires credentials below and
#       passing `npm run amazon:compliance`. See docs/AMAZON.md.
# Keep this "mock" — the Creators API isn't usable yet for either
# marketplace (see the eligibility notes below). This includes staging/
# pre-launch: going live on precocaindo.com.br does NOT require this to be
# "live" — see PUBLIC_CATALOG_ENABLED below and docs/PRODUCTION_READINESS.md.
AMAZON_PROVIDER="mock"

# --- Amazon Brasil — PETMOL, Store ID petmol-20 (informational, see
# lib/config/marketplaces.ts AMAZON_STORE_IDS; petmol-20 is PETMOL's own
# tag, never PreçoCaindo's). PreçoCaindo's OWN Tracking ID under that
# account has been created: precocaindo-20. That is the correct BR tag —
# do not change it to petmol-20. ---
AMAZON_BR_ENABLED="true"
AMAZON_BR_API_ENABLED="false"
AMAZON_BR_ASSOCIATE_TAG="precocaindo-20"

# The Amazon Creators API page for the BR account currently shows the
# account itself as NOT approved for the Creators API, and separately
# requires at least 10 qualified sales in the trailing 30 days to reach the
# PA API surface through it. NEITHER of these can be inferred from
# affiliate-panel activity (clicks, orders placed, orders shipped,
# commission accrued) — only Amazon's own approval counts. Flip these only
# after a human confirms directly with Amazon. See docs/AMAZON.md.
AMAZON_BR_CREATORS_API_ACCOUNT_APPROVED="false"
AMAZON_BR_QUALIFIED_SALES_MET="false"

# --- Amazon United States — a new PETMOL Associates account exists
# (affiliate-program.amazon.com), Associate ID petmol07-20, registered
# property petmol.com.br. precocaindo.com.br has NOT been registered on
# this account, the account is still in initial review, and bank payment
# setup is not resolved. AMAZON_US_ASSOCIATE_TAG stays empty and
# non-operational — never set it to petmol07-20, and never enable this
# marketplace until a human has: (1) registered precocaindo.com.br on the
# US account, (2) confirmed account status, (3) confirmed payment
# configuration, (4) reviewed policy/compliance for that marketplace. See
# docs/AMAZON.md. ---
AMAZON_US_ENABLED="false"
AMAZON_US_API_ENABLED="false"
AMAZON_US_ASSOCIATE_TAG=""
AMAZON_US_PRECOCAINDO_REGISTERED="false"
AMAZON_US_PAYMENT_CONFIGURED="false"

# DEPRECATED — pre-multi-marketplace fallback for AMAZON_BR_ASSOCIATE_TAG.
# Leave unset; new configuration should use AMAZON_BR_ASSOCIATE_TAG above.
AMAZON_ASSOCIATE_TAG=""

# CREDENTIALS_PENDING_OFFICIAL_CONFIGURATION — every value below is an
# unconfirmed placeholder shape, not a guess at real field names. The exact
# shape of Creators API auth is not yet confirmed against official docs —
# do not assume it matches the legacy PA-API. Do not implement
# AmazonProvider's live methods until that's confirmed, for either
# marketplace. See docs/AMAZON.md and docs/AMAZON_COMPLIANCE.md.
AMAZON_CREATORS_API_KEY=""
AMAZON_CREATORS_API_SECRET=""
AMAZON_CREATORS_API_HOST=""
AMAZON_CREATORS_API_REGION="us-east-1"

# Cache TTL (seconds) for Amazon program content, per the Creators API terms.
# Do not lower this without re-checking docs/AMAZON_COMPLIANCE.md.
AMAZON_CONTENT_TTL="3600"

# Legally required disclosure string. Centralized so it can be updated in one
# place if Amazon changes the official wording for Brazil.
AMAZON_ASSOCIATE_DISCLOSURE="Como associado da Amazon, eu ganho com compras qualificadas."

# ISO date (YYYY-MM-DD) of the last manual review of Amazon policies.
# The admin dashboard warns when this is older than 90 days.
AMAZON_POLICY_REVIEW_DATE="2026-08-18"

# --- Content generation ---
# mock: deterministic template-based content, no external calls.
# openai | anthropic: requires the matching API key below.
# off: content generation job is a no-op.
CONTENT_GENERATION="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Feature flags (keep disabled until explicitly validated) ---
AUTO_PUBLISH="false"
PRICE_ALERTS="false"
PAID_MEDIA="false"

# Gates the public catalog (/, /ofertas, /produto, /categorias, /melhores,
# /comparar). DEV: safe to leave "true" (NODE_ENV isn't "production", so
# the mock-in-production guard never triggers). STAGING/PRE-LAUNCH: keep
# "false" so the site can go live institutionally without showing
# fictional prices — see lib/config/public-catalog.ts and
# docs/PRODUCTION_READINESS.md (SITE_LAUNCH_READY vs CATALOG_LAUNCH_READY).
# Even when "true", production can never serve AMAZON_PROVIDER=mock data;
# that combination is forced back to unsafe regardless of this flag.
PUBLIC_CATALOG_ENABLED="false"

# --- Admin ---
# scrypt-hashed admin password ("scrypt:<saltHex>:<hashHex>"), generated
# with `npm run admin:hash-password -- 'your-password'` — NEVER the
# plaintext password itself. Leave empty for local dev only: /admin is then
# open without login, but ONLY outside production (see lib/admin/auth.ts).
# Required before any real deploy — production:readiness's ADMIN_SECURED
# check fails hard without it. See docs/PRODUCTION_READINESS.md.
ADMIN_PASSWORD_HASH=""
