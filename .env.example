# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://precocaindo:precocaindo@localhost:5433/precocaindo"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PreçoCaindo"

# --- Amazon provider ---
# mock: uses MockAmazonProvider, no external calls, safe for local dev.
# live: uses AmazonProvider (Creators API). Requires credentials below and
#       passing `npm run amazon:compliance`. See docs/AMAZON.md.
AMAZON_PROVIDER="mock"

# CREDENTIALS_PENDING_OFFICIAL_CONFIGURATION — every value in this block is
# an unconfirmed placeholder, not a guess at real field names. The PETMOL
# Amazon Associates account (Store ID: petmol-20) already exists, but:
#   (a) PreçoCaindo needs its OWN Tracking ID under that account, to keep
#       its analytics separate from PETMOL's — that value has not been
#       created/provided yet. NEVER set this to "petmol-20".
#   (b) Creators API access additionally requires (per Amazon's own FAQ):
#       an approved Associate account AND at least 10 qualified sales in
#       the trailing 30 days to reach the PA API surface through the
#       Creators API. Until both are true, credentials generated here will
#       fail with AssociateNotEligible (can take up to 48h to clear even
#       once eligible). See docs/AMAZON.md and docs/AMAZON_COMPLIANCE.md.
#   (c) The exact shape of Creators API auth (these KEY/SECRET names) is
#       not yet confirmed against official docs — do not assume it matches
#       the legacy PA-API. Do not implement AmazonProvider's live methods
#       until that's confirmed.
AMAZON_ASSOCIATE_TAG=""
AMAZON_CREATORS_API_KEY=""
AMAZON_CREATORS_API_SECRET=""
AMAZON_CREATORS_API_HOST=""
AMAZON_CREATORS_API_REGION="us-east-1"

# Cache TTL (seconds) for Amazon program content, per the Creators API terms.
# Do not lower this without re-checking docs/AMAZON_COMPLIANCE.md.
AMAZON_CONTENT_TTL="3600"

# Legally required disclosure string. Centralized so it can be updated in one
# place if Amazon changes the official wording for Brazil.
AMAZON_ASSOCIATE_DISCLOSURE="Como associado da Amazon, eu ganho com compras qualificadas."

# ISO date (YYYY-MM-DD) of the last manual review of Amazon policies.
# The admin dashboard warns when this is older than 90 days.
AMAZON_POLICY_REVIEW_DATE="2026-08-17"

# --- Content generation ---
# mock: deterministic template-based content, no external calls.
# openai | anthropic: requires the matching API key below.
# off: content generation job is a no-op.
CONTENT_GENERATION="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Feature flags (keep disabled until explicitly validated) ---
AUTO_PUBLISH="false"
PRICE_ALERTS="false"
PAID_MEDIA="false"

# --- Admin ---
# Shared secret gating /admin until real auth is implemented. Development
# only — see docs/PRODUCTION_READINESS.md.
ADMIN_ACCESS_TOKEN=""
