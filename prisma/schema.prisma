// PreçoCaindo — core data model.
// See docs/ARCHITECTURE.md for how these entities fit into the automation cycle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommerceProviderName {
  AMAZON
}

/// Kept intentionally small — see lib/config/marketplaces.ts for the
/// runtime config each code maps to (host, currency, enabled, tag).
enum Marketplace {
  BR
  US
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum ContentType {
  PRODUCT
  BEST_OF
  COMPARISON
  CATEGORY
  DEAL_SUMMARY
}

enum ContentStatus {
  DRAFT
  VALIDATING
  APPROVED
  REJECTED
  PUBLISHED
  STALE
}

enum DemandIntent {
  PRODUCT_RESEARCH
  PRICE
  DEAL
  BEST_OF
  COMPARISON
  CATEGORY
  INFORMATIONAL
}

enum OpportunityStatus {
  PENDING
  IN_PROGRESS
  DONE
  DISCARDED
}

enum AutomationStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum UpdatePriority {
  HOT
  WARM
  COLD
}

enum AlertChannel {
  EMAIL
}

enum CreativeType {
  PRICE_DROP
  OPPORTUNITY
  BEST_OF
}

enum CreativeFormat {
  OG_IMAGE
  INSTAGRAM_FEED
  INSTAGRAM_STORY
  PINTEREST
}

enum CreativeStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum ConsentChoice {
  GRANTED
  DENIED
  UNSET
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  active   Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id             String   @id @default(cuid())
  asin           String
  provider       CommerceProviderName @default(AMAZON)
  slug           String   @unique
  title          String
  brand          String?
  description    String?
  imageUrl       String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  specifications Json?
  rating         Float?
  reviewCount    Int?
  active         Boolean  @default(true)
  updatePriority UpdatePriority @default(COLD)
  /// Set whenever ProductPriorityService changes updatePriority. Used both
  /// for hysteresis (avoid flapping HOT/WARM on noisy signals) and for
  /// admin observability ("idade da última mudança de prioridade").
  priorityUpdatedAt DateTime @default(now())

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers          Offer[]
  priceHistory    PriceHistory[]
  priceStats      PriceStats?
  opportunityScore OpportunityScore?
  affiliateClicks AffiliateClick[]
  priceAlerts     PriceAlert[]
  creatives       Creative[]
  searchOpportunities SearchOpportunity[]
  pageViews       PageView[]

  @@unique([provider, asin])
  @@index([categoryId])
  @@index([updatePriority])
  @@index([active])
}

model Offer {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider           CommerceProviderName @default(AMAZON)
  price              Decimal  @db.Decimal(10, 2)
  currency           String   @default("BRL")
  originalPrice      Decimal? @db.Decimal(10, 2)
  discountPercentage Float?
  affiliateUrl       String
  availability       Availability @default(UNKNOWN)
  observedAt         DateTime @default(now())

  @@index([productId, observedAt])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider   CommerceProviderName @default(AMAZON)
  price      Decimal  @db.Decimal(10, 2)
  observedAt DateTime @default(now())

  @@index([productId, observedAt])
}

model PriceStats {
  id String @id @default(cuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  currentPrice     Decimal  @db.Decimal(10, 2)
  lowestPrice      Decimal  @db.Decimal(10, 2)
  highestPrice     Decimal  @db.Decimal(10, 2)
  avg7d            Decimal? @db.Decimal(10, 2)
  avg30d           Decimal? @db.Decimal(10, 2)
  avg90d           Decimal? @db.Decimal(10, 2)
  dropPercentage   Float?
  distanceFromLow  Float?
  historicalPosition Float?
  dataPointCount   Int      @default(0)
  coverageDays     Int      @default(0)

  calculatedAt DateTime @default(now())
}

model OpportunityScore {
  id String @id @default(cuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  score            Int
  priceScore       Int
  discountScore    Int
  popularityScore  Int
  ratingScore      Int
  historicalScore  Int
  confidence       Float

  calculatedAt DateTime @default(now())

  @@index([score])
}

model AffiliateClick {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider  CommerceProviderName @default(AMAZON)
  pageType  String
  pageSlug  String
  source    String?
  campaign  String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// A first-party pageview, used as a demand/traffic signal and for the
/// admin dashboard. No IP, no fingerprinting — `sessionId` is a
/// pseudonymous, client-generated identifier (see lib/analytics).
model PageView {
  id             String   @id @default(cuid())
  pageType       String
  pageSlug       String
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  referrerDomain String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  sessionId      String

  createdAt DateTime @default(now())

  @@index([pageType, pageSlug, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

/// Internal site search, used as a demand signal by DemandEngine. No IP.
model SearchEvent {
  id                String   @id @default(cuid())
  query             String
  normalizedQuery   String
  resultCount       Int
  clickedProductId  String?

  createdAt DateTime @default(now())

  @@index([normalizedQuery, createdAt])
  @@index([createdAt])
}

model GeneratedContent {
  id            String        @id @default(cuid())
  contentType   ContentType
  entityId      String?
  slug          String
  title         String
  metaTitle     String
  metaDescription String
  body          String
  model         String
  promptVersion String
  status        ContentStatus @default(DRAFT)
  qualityScore  Int?
  qualityReasons Json?
  /// Multi-dimensional ContentQualityGate breakdown: originality,
  /// dataSupport, usefulness, duplicationRisk, commercialTransparency.
  qualityBreakdown Json?
  /// Hash of the normalized body, used by the duplication/similarity check
  /// in ContentQualityGate to flag near-identical scaled content.
  contentHash   String?
  /// True when PublicationDecisionEngine decided NOINDEX: the page may
  /// still be served, but must not be indexed or listed in the sitemap.
  noindex       Boolean       @default(false)
  /// SearchOpportunity.overallScore at the time content was generated, kept
  /// for decision transparency/audit, not recalculated after the fact.
  demandScoreAtGeneration Float?

  generatedAt DateTime  @default(now())
  reviewedAt  DateTime?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([contentType, slug])
  @@index([status])
  @@index([entityId])
  @@index([contentHash])
}

model SearchOpportunity {
  id                String   @id @default(cuid())
  keyword           String
  normalizedKeyword String
  intent            DemandIntent @default(PRODUCT_RESEARCH)
  category          String?
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])
  /// Where this opportunity was discovered — e.g. "internal_search",
  /// "product_catalog", "manual_seed". See lib/demand/sources.
  source            String
  demandScore       Float?
  commercialScore   Float?
  freshnessScore    Float?
  contentGapScore   Float?
  overallScore      Float?
  priority          Int      @default(0)
  status            OpportunityStatus @default(PENDING)

  discoveredAt   DateTime  @default(now())
  lastEvaluatedAt DateTime?

  @@index([status, priority])
  @@index([normalizedKeyword])
}

model AutomationRun {
  id          String       @id @default(cuid())
  job         String
  /// Which marketplace this run processed, when the job is scoped to one
  /// (product discovery/refresh/scoring). Null for jobs that aren't
  /// marketplace-scoped (content validation/publish, cleanup, sitemap
  /// refresh). See lib/jobs/automation-run.ts runJob() `options.marketplace`.
  marketplace Marketplace?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  status      AutomationStatus @default(RUNNING)
  processed   Int          @default(0)
  created     Int          @default(0)
  updated     Int          @default(0)
  errors      Int          @default(0)
  metadata    Json?

  @@index([job, startedAt])
  @@index([job, status])
  @@index([job, marketplace, startedAt])
}

model PriceAlert {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Decimal  @db.Decimal(10, 2)
  channel     AlertChannel @default(EMAIL)
  /// The contact itself (e.g. email address). Stored only because a price
  /// alert is functionally impossible to deliver without it — this is data
  /// minimization *for the stated purpose*, not maximization. Never reused
  /// for marketing without a separate MARKETING consent (see
  /// docs/PRIVACY.md).
  contact         String
  /// Deterministic hash of the normalized contact, used to detect/prevent
  /// duplicate alerts without needing to compare plaintext in ordinary
  /// queries.
  contactHash     String
  /// Double opt-in: an alert is not active until the confirmation link
  /// (using this token) has been used. PRICE_ALERTS=false today, so no
  /// email is actually sent yet — see docs/AUTOMATION.md.
  confirmationToken String?
  confirmedAt       DateTime?
  active            Boolean  @default(true)

  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  @@index([productId, active])
  @@index([contactHash])
}

model Creative {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           CreativeType
  format         CreativeFormat
  headline       String
  subtitle       String?
  price          Decimal        @db.Decimal(10, 2)
  previousPrice  Decimal?       @db.Decimal(10, 2)
  discount       Float?
  imageUrl       String?
  destinationUrl String
  status         CreativeStatus @default(DRAFT)

  createdAt DateTime @default(now())

  @@index([productId, status])
}

/// Permanent redirect registered whenever a published slug changes.
/// oldPath/newPath are full site paths (e.g. "/produto/antigo-slug").
model SlugRedirect {
  id         String   @id @default(cuid())
  oldPath    String   @unique
  newPath    String
  statusCode Int      @default(301)

  createdAt DateTime @default(now())

  @@index([newPath])
}

/// LGPD consent, keyed by a pseudonymous subject id (a client-generated,
/// non-personal identifier stored in a first-party cookie — never an email
/// or account id). One row per subject; choices are overwritten in place so
/// there is always exactly one current answer, never a growing log of a
/// person's consent history.
model ConsentRecord {
  id         String   @id @default(cuid())
  subjectId  String   @unique
  analytics  ConsentChoice @default(UNSET)
  marketing  ConsentChoice @default(UNSET)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
